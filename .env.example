# Доступ к закрытым страницам /group-statistics и /group-statistics/new
AIZ_STATS_PASSWORD=replace-with-a-strong-password
# Независимый секрет подписи cookie: openssl rand -hex 32
AIZ_STATS_SESSION_SECRET=replace-with-a-random-secret

# Постоянное хранилище записей (на VPS каталог shared не удаляется при деплое)
AIZ_STATS_DATA_FILE=/opt/internetaddicts/shared/group-statistics.json

# Дублирование каждой записи в Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/internetaddicts/shared/google-service-account.json
AIZ_STATS_SPREADSHEET_ID=1qaSmvkymqUMT_Y-VwbSdDFEi0hDGVcxkU67AE_lLoR4
AIZ_STATS_SHEET_RANGE=Лист1!A:G
