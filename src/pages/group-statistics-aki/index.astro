---
import RecordsPage from "@/components/group-statistics/RecordsPage.astro"
import Layout from "@/layout/Layout.astro"
import { AKI_DATASET } from "@/lib/group-statistics/datasets"
import { loadRecordsPage } from "@/lib/group-statistics/pageActions"

export const prerender = false

const dataset = AKI_DATASET
const state = await loadRecordsPage(dataset, Astro)
if (state.redirectTo) return Astro.redirect(state.redirectTo, 303)
if (state.status) Astro.response.status = state.status
---

<Layout noIndex title={dataset.title} desc={dataset.description}>
	<RecordsPage dataset={dataset} state={state} />
</Layout>
